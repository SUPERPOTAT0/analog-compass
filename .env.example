# Analog Compass — environment variables (NAMES ONLY; never commit real values)

# Data bundle selection
DATA_MODE=synthetic              # synthetic | real
DATA_BUNDLE_URI=data/synthetic   # path or object-store URI
DATA_VERSION=synthetic-0.1.0

# Engine
ENGINE_N_DRAWS=512
ENGINE_SEED_SALT=analog-compass

# AI agent (optional; required only to run /agent/chat)
ANTHROPIC_API_KEY=
ANALOG_AGENT_MODEL=              # leave blank to use the server default; see docs/08_AI_AGENT.md
ANALOG_AGENT_MAX_TOOL_ITERS=8

# API
ALLOWED_ORIGINS=http://localhost:3000
